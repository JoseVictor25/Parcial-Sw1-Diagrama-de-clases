package {{ base_package }}.dto;

import java.io.Serializable;
{% if entity.has_dates %}
import java.time.LocalDate;
{% endif %}
{% if entity.has_datetimes %}
import java.time.LocalDateTime;
{% endif %}
{% if entity.has_bigdecimals %}
import java.math.BigDecimal;
{% endif %}

/**
 * DTO para solicitudes de creación y edición de {{ entity.name }}.
 */
public class {{ entity.name }}RequestDTO implements Serializable {

    private static final long serialVersionUID = 1L;

    // Campos de entrada
{% for attr in entity.attributes %}
    {% if not attr.is_id or not attr.is_generated %}
    private {{ attr.java_type }} {{ attr.field_name }};
    {% endif %}
{% endfor %}

    // Claves foráneas para relaciones
{% for rel in entity.relationships %}
    {% if not rel.is_collection %}
    private Long {{ rel.fk_id_field }};
    {% endif %}
{% endfor %}

    public {{ entity.name }}RequestDTO() {
    }

    // Getters y Setters
{% for attr in entity.attributes %}
    {% if not attr.is_id or not attr.is_generated %}
    public {{ attr.java_type }} {{ attr.getter_name }}() {
        return {{ attr.field_name }};
    }

    public void {{ attr.setter_name }}({{ attr.java_type }} {{ attr.field_name }}) {
        this.{{ attr.field_name }} = {{ attr.field_name }};
    }

    {% endif %}
{% endfor %}
{% for rel in entity.relationships %}
    {% if not rel.is_collection %}
    public Long {{ rel.fk_getter_name }}() {
        return {{ rel.fk_id_field }};
    }

    public void {{ rel.fk_setter_name }}(Long {{ rel.fk_id_field }}) {
        this.{{ rel.fk_id_field }} = {{ rel.fk_id_field }};
    }

    {% endif %}
{% endfor %}
}
